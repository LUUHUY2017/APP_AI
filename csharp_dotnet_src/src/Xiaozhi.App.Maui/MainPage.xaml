<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Xiaozhi.App.Maui.MainPage"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#0a0814">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="14,6,14,12" VerticalOptions="FillAndExpand">
        <!-- Modern Cyberpunk Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="2,4,2,10">
            <Frame Grid.Column="0" WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0"
                   BackgroundColor="#8a2be2" BorderColor="#00f2fe" HasShadow="False" VerticalOptions="Center">
                <Label Text="🌸" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Lily AI" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" />
                    <Frame BackgroundColor="#1f1838" BorderColor="#00f2fe" CornerRadius="6" Padding="4,1" HasShadow="False" VerticalOptions="Center">
                        <Label Text="v1.2" FontSize="9" FontAttributes="Bold" TextColor="#00f2fe" />
                    </Frame>
                </HorizontalStackLayout>
                <Label x:Name="StatusLabel" Text="🟢 Lily AI Sẵn sàng" FontSize="11" TextColor="#a09cc0" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                <Button x:Name="HandsFreeBtn" Text="🎙️ Rảnh tay" BackgroundColor="#1e1838"
                        TextColor="#dcd8fc" FontSize="11" FontAttributes="Bold"
                        HeightRequest="36" Padding="10,0" CornerRadius="18" BorderColor="#3b3370"
                        Clicked="OnHandsFreeClicked" />
                <Button Text="🔄" BackgroundColor="#1e1838" TextColor="#dcd8fc"
                        FontSize="15" WidthRequest="36" HeightRequest="36" CornerRadius="10" BorderColor="#3b3370"
                        Padding="0" Clicked="OnRefreshClicked" />
                <Button Text="⚙️" BackgroundColor="#1e1838" TextColor="#dcd8fc"
                        FontSize="15" WidthRequest="36" HeightRequest="36" CornerRadius="10" BorderColor="#3b3370"
                        Padding="0" Clicked="OnSettingsClicked" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Chat Stream Area -->
        <ScrollView Grid.Row="1" x:Name="ChatScrollView" VerticalOptions="FillAndExpand">
            <VerticalStackLayout x:Name="ChatStack" Spacing="14" Padding="0,8">
                <!-- Welcome Card -->
                <Frame BackgroundColor="#16122c" BorderColor="#3b3370" CornerRadius="16" Padding="14,12" HasShadow="False">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🌸 Lily AI" FontSize="12" FontAttributes="Bold" TextColor="#00f2fe" />
                        <Label Text="Xin chào! Mình là Lily — Trợ lý ảo giọng nói AI. Chạm nút 🎤 Bấm để nói bên dưới để trò chuyện cùng mình nhé!"
                               TextColor="#f0eefc" FontSize="14" LineHeight="1.4" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Subtitle & Live Status -->
        <Label Grid.Row="2" x:Name="CurrentMsgLabel" Text="✨ Sẵn sàng trò chuyện cùng bạn"
               FontSize="12" TextColor="#a09cc0" HorizontalOptions="Center" Margin="0,4,0,8" />

        <!-- Floating Action Capsule Bar -->
        <Frame Grid.Row="3" BackgroundColor="#141026" CornerRadius="28" Padding="6,4"
               HasShadow="False" BorderColor="#3b3370" Margin="0,0,0,4">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="Center">
                <!-- Main Text Entry -->
                <Entry Grid.Column="0" x:Name="TextInput" Placeholder="Gõ câu hỏi vào đây..."
                       PlaceholderColor="#6c688a" TextColor="#FFFFFF" BackgroundColor="Transparent"
                       Keyboard="Text" ReturnType="Send" Completed="OnSendClicked"
                       ClearButtonVisibility="WhileEditing" FontSize="14"
                       VerticalOptions="Center" HeightRequest="44" Margin="10,0,0,0" />

                <!-- Grand Voice / Send Button Capsule -->
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Button x:Name="MicButton" Text="🎤" BackgroundColor="#6c47ff" TextColor="#FFFFFF"
                            FontSize="18" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                            VerticalOptions="Center" Clicked="OnMicButtonClicked" />
                    <Button x:Name="SendButton" Text="➤" BackgroundColor="#00f2fe"
                            TextColor="#080612" FontSize="14" FontAttributes="Bold"
                            WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0"
                            VerticalOptions="Center" Clicked="OnSendClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
