<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xiaozhi.App.Maui.MainPage"
             BackgroundColor="#0d0b1a">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="15">
        <!-- Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,10,0,15">
            <StackLayout Grid.Column="0">
                <Label Text="🌸 Lily AI Assistant" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                <Label x:Name="StatusLabel" Text="✅ Sẵn sàng" FontSize="13" TextColor="#a0a0c0" />
            </StackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                <Button x:Name="HandsFreeBtn" Text="🎙️ Rảnh tay: Tắt" 
                        BackgroundColor="#1c1936" TextColor="#ffffff" 
                        CornerRadius="18" Padding="10,6" Clicked="OnHandsFreeClicked" />
                <Button Text="🔄" BackgroundColor="#1c1936" TextColor="#ffffff"
                        CornerRadius="18" Padding="10,6" Clicked="OnRefreshClicked" ToolTipProperties.Text="Đồng bộ" />
                <Button Text="⚙" BackgroundColor="#1c1936" TextColor="#ffffff"
                        CornerRadius="18" Padding="10,6" Clicked="OnSettingsClicked" ToolTipProperties.Text="Cài đặt" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Message List area -->
        <ScrollView Grid.Row="1" x:Name="ChatScrollView">
            <VerticalStackLayout x:Name="ChatStack" Spacing="10">
                <Frame BackgroundColor="#18152e" CornerRadius="12" Padding="12" HasShadow="False" BorderColor="Transparent">
                    <Label Text="Xin chào! Tôi là Lily. Tôi có thể giúp gì cho sếp hôm nay?" TextColor="#e0e0ff" FontSize="15" />
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Status Message Banner -->
        <Frame Grid.Row="2" BackgroundColor="#15122b" CornerRadius="10" Padding="10" Margin="0,10" HasShadow="False" BorderColor="#2a254d">
            <Label x:Name="CurrentMsgLabel" Text="Bấm 🎤 để nói (hoặc nói xong tự ngắt)" TextColor="#9a9ad0" FontSize="13" HorizontalOptions="Center" />
        </Frame>

        <!-- Bottom Controls -->
        <Grid Grid.Row="3" RowDefinitions="Auto, Auto" RowSpacing="10">
            <!-- Mic Record Button -->
            <Button Grid.Row="0" x:Name="MicButton" Text="🎤 Bấm để nói" 
                    HeightRequest="54" CornerRadius="27"
                    BackgroundColor="#6c5ce7" TextColor="#ffffff" FontAttributes="Bold" FontSize="17"
                    Clicked="OnMicButtonClicked" />

            <!-- Text Input Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="TextInput" Placeholder="Nhập câu hỏi tiếng Việt..." 
                       PlaceholderColor="#606080" TextColor="#ffffff" BackgroundColor="#1c1936" 
                       HeightRequest="44" />
                <Button Grid.Column="1" Text="Gửi" BackgroundColor="#8a2be2" TextColor="#ffffff" 
                        WidthRequest="70" HeightRequest="44" CornerRadius="8" Clicked="OnSendClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
