<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Xiaozhi.App.Maui.MainPage"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#0d0b1a">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="14,8,14,14" VerticalOptions="FillAndExpand">
        <!-- Top Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,4,0,12">
            <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Image Source="susu_logo.png" WidthRequest="34" HeightRequest="34" Margin="0,0,8,0" VerticalOptions="Center" />
                <StackLayout VerticalOptions="Center">
                    <Label Text="SUSU FILM AI" FontSize="19" FontAttributes="Bold" TextColor="#FFFFFF" />
                    <Label x:Name="StatusLabel" Text="✅ Sẵn sàng" FontSize="12" TextColor="#a0a0c0" />
                </StackLayout>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Button x:Name="HandsFreeBtn" Text="🎙️ Rảnh tay: Tắt" 
                        BackgroundColor="#1c1936" TextColor="#ffffff" 
                        CornerRadius="18" Padding="10,6" Clicked="OnHandsFreeClicked" />
                <Button Text="🔄" BackgroundColor="#1c1936" TextColor="#ffffff"
                        CornerRadius="18" Padding="10,6" Clicked="OnRefreshClicked" ToolTipProperties.Text="Đồng bộ" />
                <Button Text="⚙" BackgroundColor="#1c1936" TextColor="#ffffff"
                        CornerRadius="18" Padding="10,6" Clicked="OnSettingsClicked" ToolTipProperties.Text="Cài đặt" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Message List area -->
        <ScrollView Grid.Row="1" x:Name="ChatScrollView" VerticalOptions="FillAndExpand">
            <VerticalStackLayout x:Name="ChatStack" Spacing="10">
                <Frame BackgroundColor="#18152e" CornerRadius="12" Padding="12" HasShadow="False" BorderColor="Transparent">
                    <Label Text="Xin chào! Tôi là Lily. Tôi có thể giúp gì cho sếp hôm nay?" TextColor="#e0e0ff" FontSize="15" />
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Status Message Banner -->
        <Frame Grid.Row="2" BackgroundColor="#15122b" CornerRadius="10" Padding="10" Margin="0,8" HasShadow="False" BorderColor="#2a254d">
            <Label x:Name="CurrentMsgLabel" Text="Bấm 🎤 để nói (hoặc nói xong tự ngắt)" TextColor="#9a9ad0" FontSize="13" HorizontalOptions="Center" />
        </Frame>

        <!-- Bottom Controls -->
        <Grid Grid.Row="3" RowDefinitions="Auto, Auto" RowSpacing="10" VerticalOptions="End">
            <!-- Mic Record Button -->
            <Button Grid.Row="0" x:Name="MicButton" Text="🎤 Bấm để nói" 
                    HeightRequest="52" CornerRadius="26"
                    BackgroundColor="#6c5ce7" TextColor="#ffffff" FontAttributes="Bold" FontSize="17"
                    Clicked="OnMicButtonClicked" />

            <!-- Text Input Row -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" BackgroundColor="#1c1936" CornerRadius="22" Padding="12,0" HasShadow="False" BorderColor="Transparent" HeightRequest="44">
                    <Entry x:Name="TextInput" Placeholder="Nhập câu hỏi tiếng Việt..." 
                           PlaceholderColor="#606080" TextColor="#ffffff" BackgroundColor="Transparent"
                           Keyboard="Text" ReturnType="Send" Completed="OnSendClicked"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center" HeightRequest="44" />
                </Frame>
                <Button Grid.Column="1" Text="Gửi" BackgroundColor="#8a2be2" TextColor="#ffffff" 
                        WidthRequest="70" HeightRequest="44" CornerRadius="22" FontAttributes="Bold" Clicked="OnSendClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
