<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Xiaozhi.App.Maui.MainPage"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#070412">

    <Grid x:Name="MainGrid" RowDefinitions="Auto, *, Auto, Auto" Padding="12,6,12,12" VerticalOptions="FillAndExpand">
        <!-- Vibrant Cyberpunk Header Card -->
        <Frame Grid.Row="0" BackgroundColor="#130a2a" BorderColor="#bd00ff" CornerRadius="18" Padding="10,8" HasShadow="False" Margin="0,4,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="14" Padding="0"
                       BackgroundColor="#bd00ff" BorderColor="#00f2fe" HasShadow="False" VerticalOptions="Center">
                    <Label Text="⚡" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="LILY AI" FontSize="18" FontAttributes="Bold" TextColor="#00F2FE" CharacterSpacing="1.2" />
                        <Frame BackgroundColor="#ff0055" BorderColor="#ff5e36" CornerRadius="6" Padding="5,1" HasShadow="False" VerticalOptions="Center">
                            <Label Text="NEON v1.2" FontSize="9" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </Frame>
                    </HorizontalStackLayout>
                    <Label x:Name="StatusLabel" Text="🟢 REALTIME AI ACTIVE" FontSize="11" TextColor="#00FF9D" FontAttributes="Bold" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                    <Button x:Name="HandsFreeBtn" Text="🎙️ Rảnh tay" BackgroundColor="#221045"
                            TextColor="#00FF9D" FontSize="11" FontAttributes="Bold"
                            HeightRequest="36" Padding="10,0" CornerRadius="18" BorderColor="#00FF9D"
                            Clicked="OnHandsFreeClicked" />
                    <Button Text="🐞" BackgroundColor="#221045" TextColor="#FF5E36"
                            FontSize="15" WidthRequest="36" HeightRequest="36" CornerRadius="10" BorderColor="#FF5E36"
                            Padding="0" Clicked="OnDebugLogClicked" />
                    <Button Text="🔄" BackgroundColor="#221045" TextColor="#00F2FE"
                            FontSize="15" WidthRequest="36" HeightRequest="36" CornerRadius="10" BorderColor="#00F2FE"
                            Padding="0" Clicked="OnRefreshClicked" />
                    <Button Text="⚙️" BackgroundColor="#221045" TextColor="#BD00FF"
                            FontSize="15" WidthRequest="36" HeightRequest="36" CornerRadius="10" BorderColor="#BD00FF"
                            Padding="0" Clicked="OnSettingsClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>

        <!-- Chat Stream Area -->
        <ScrollView Grid.Row="1" x:Name="ChatScrollView" VerticalOptions="FillAndExpand">
            <VerticalStackLayout x:Name="ChatStack" Spacing="14" Padding="0,6">
                <!-- Cyber Neon Welcome Banner -->
                <Frame BackgroundColor="#100824" BorderColor="#00f2fe" CornerRadius="18" Padding="14,14" HasShadow="False">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Frame BackgroundColor="#ff5e36" CornerRadius="4" Padding="6,2" HasShadow="False">
                                <Label Text="🔥 SYSTEM READY" FontSize="10" FontAttributes="Bold" TextColor="#FFFFFF" />
                            </Frame>
                            <Frame BackgroundColor="#00ff9d" CornerRadius="4" Padding="6,2" HasShadow="False">
                                <Label Text="⚡ REALTIME NLP" FontSize="10" FontAttributes="Bold" TextColor="#000000" />
                            </Frame>
                        </HorizontalStackLayout>
                        <Label Text="Xin chào! Mình là Lily AI — Trợ lý ảo thông minh. Chạm nút 🎤 bên dưới hoặc gõ câu hỏi để bắt đầu trò chuyện cùng mình nhé!"
                               TextColor="#E2D9F3" FontSize="14" LineHeight="1.45" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Subtitle & Live Status -->
        <Label Grid.Row="2" x:Name="CurrentMsgLabel" Text="✨ Sẵn sàng trò chuyện cùng bạn"
               FontSize="12" TextColor="#00F2FE" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,4,0,8" />

        <!-- Floating Vibrant Capsule Bar -->
        <Frame Grid.Row="3" BackgroundColor="#110926" CornerRadius="28" Padding="6,4"
               HasShadow="False" BorderColor="#bd00ff" Margin="0,0,0,4">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalOptions="Center">
                <!-- Main Text Entry -->
                <Entry Grid.Column="0" x:Name="TextInput" Placeholder="Gõ câu hỏi tại đây..."
                       PlaceholderColor="#836b9e" TextColor="#FFFFFF" BackgroundColor="Transparent"
                       Keyboard="Text" ReturnType="Send" Completed="OnSendClicked"
                       ClearButtonVisibility="WhileEditing" FontSize="14"
                       VerticalOptions="Center" HeightRequest="44" Margin="10,0,0,0" />

                <!-- Grand Voice / Send Button Capsule -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button x:Name="MicButton" Text="🎤" BackgroundColor="#bd00ff" TextColor="#FFFFFF"
                            FontSize="18" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                            BorderColor="#ff0055" VerticalOptions="Center" Clicked="OnMicButtonClicked" />
                    <Button x:Name="SendButton" Text="➤" BackgroundColor="#00f2fe"
                            TextColor="#070412" FontSize="16" FontAttributes="Bold"
                            WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                            VerticalOptions="Center" Clicked="OnSendClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
