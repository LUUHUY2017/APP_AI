<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Xiaozhi.App.Maui.MainPage"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#000000">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="14,4,14,10" VerticalOptions="FillAndExpand">
        <!-- Compact modern header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="2,4,2,10">
            <Image Grid.Column="0" Source="susu_logo.png" WidthRequest="32" HeightRequest="32"
                   Aspect="AspectFit" VerticalOptions="Center" HorizontalOptions="Start" />

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center" HorizontalOptions="Start">
                <Label Text="TONY AI ⌄" FontSize="16" FontAttributes="Bold"
                       TextColor="#F5F7FA" LineBreakMode="NoWrap" HorizontalOptions="Start" />
                <Label x:Name="StatusLabel" Text="✅ Sẵn sàng" FontSize="11"
                       TextColor="#8F9BA8" LineBreakMode="TailTruncation" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Button x:Name="HandsFreeBtn" Text="🎙 Rảnh tay" BackgroundColor="#171A20"
                        TextColor="#B8C1CC" FontSize="11" FontAttributes="Bold"
                        HeightRequest="36" Padding="10,0" CornerRadius="18"
                        Clicked="OnHandsFreeClicked" ToolTipProperties.Text="Rảnh tay" />
                <Button Text="↻" BackgroundColor="#171A20" TextColor="#B8C1CC"
                        FontSize="19" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                        Padding="0" Clicked="OnRefreshClicked" ToolTipProperties.Text="Tải lại" />
                <Button Text="⚙" BackgroundColor="#171A20" TextColor="#B8C1CC"
                        FontSize="16" WidthRequest="36" HeightRequest="36" CornerRadius="18"
                        Padding="0" Clicked="OnSettingsClicked" ToolTipProperties.Text="Cài đặt" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Gemini Chat Log Area -->
        <ScrollView Grid.Row="1" x:Name="ChatScrollView" VerticalOptions="FillAndExpand">
            <VerticalStackLayout x:Name="ChatStack" Spacing="16" Padding="0,10">
                <!-- Welcome Message Gemini Style -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Xin chào sếp! Mình là Tony - SUSU FILM AI. Mình có thể hỗ trợ gì cho bạn hôm nay?" 
                           TextColor="#F1F1F1" FontSize="16" LineHeight="1.4" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Gemini Disclaimer Footer -->
        <Label Grid.Row="2" x:Name="CurrentMsgLabel" Text="SUSU FILM AI là một trợ lý ảo AI và có thể mắc sai sót." 
               FontSize="11" TextColor="#8E918F" HorizontalOptions="Center" Margin="0,4,0,8" />

        <!-- Floating Gemini Input Capsule Bar -->
        <Frame Grid.Row="3" BackgroundColor="#171A20" CornerRadius="26" Padding="7,4"
               HasShadow="False" BorderColor="Transparent" Margin="0,0,0,4">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="4" VerticalOptions="Center">
                <!-- Plus Button -->
                <Button Grid.Column="0" Text="＋" BackgroundColor="Transparent" TextColor="#AEB7C2" FontSize="22"
                        WidthRequest="40" HeightRequest="40" Padding="0" VerticalOptions="Center" Clicked="OnPlusClicked" />

                <!-- Main Text Entry -->
                <Entry Grid.Column="1" x:Name="TextInput" Placeholder="Hỏi SUSU FILM AI..." 
                       PlaceholderColor="#8E918F" TextColor="#FFFFFF" BackgroundColor="Transparent"
                       Keyboard="Text" ReturnType="Send" Completed="OnSendClicked"
                       ClearButtonVisibility="WhileEditing" FontSize="15"
                       VerticalOptions="Center" HeightRequest="44" />

                <!-- Mic Record Button -->
                <Button Grid.Column="2" x:Name="MicButton" Text="🎙" BackgroundColor="Transparent" TextColor="#AEB7C2"
                        FontSize="20" WidthRequest="40" HeightRequest="40" Padding="0" VerticalOptions="Center" Clicked="OnMicButtonClicked" />

                <!-- Clear text send action -->
                <Button Grid.Column="3" x:Name="SendButton" Text="Gửi" BackgroundColor="#7C5CFC"
                        TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold"
                        WidthRequest="54" HeightRequest="40" CornerRadius="20" Padding="0"
                        VerticalOptions="Center" Clicked="OnSendClicked" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
