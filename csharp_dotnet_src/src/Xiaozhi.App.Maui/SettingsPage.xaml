<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Xiaozhi.App.Maui.SettingsPage"
             Title="⚙ Cài đặt Server"
             ios:Page.UseSafeArea="True"
             BackgroundColor="#0d0b1a">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <Label Text="⚙ Cài đặt Cấu hình Server" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" Margin="0,10,0,2" />
            <Label Text="Tùy chỉnh thông số kết nối Xiaozhi Server (Tenclass):" FontSize="13" TextColor="#a0a0c0" />

            <!-- OTP Activation Card (Matching WPF App) -->
            <Frame BackgroundColor="#16142c" CornerRadius="14" Padding="14" HasShadow="False" BorderColor="#3b3370" Margin="0,4,0,8">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="🔑" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Kích hoạt &amp; Tự động lấy Token (Mã OTP)" FontSize="15" FontAttributes="Bold" TextColor="#f0f0ff" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label x:Name="OtpStatusLabel" Text="Nhấn nút bên dưới để tạo mã OTP 6 số ghép nối thiết bị trên xiaozhi.me" FontSize="12" TextColor="#b0b0d0" />

                    <!-- Big OTP Code & Serial Box -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Mã xác minh (OTP):" FontSize="11" TextColor="#a0a0ff" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="📋 Chép" BackgroundColor="#222044" TextColor="#00FFC8" FontSize="10" Padding="4,1" HeightRequest="24" Clicked="OnCopyOtpClicked" />
                            </Grid>
                            <Frame BackgroundColor="#0d0b1a" CornerRadius="10" Padding="8,6" HasShadow="False" BorderColor="#4a3e8c">
                                <Label x:Name="OtpCodeLabel" Text="------" FontSize="20" FontAttributes="Bold" TextColor="#00FFC8" HorizontalOptions="Center" />
                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Serial nội bộ (không nhập web):" FontSize="11" TextColor="#a0a0ff" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="📋 Chép" BackgroundColor="#222044" TextColor="#FFDD00" FontSize="10" Padding="4,1" HeightRequest="24" Clicked="OnCopySerialClicked" />
                            </Grid>
                            <Frame BackgroundColor="#0d0b1a" CornerRadius="10" Padding="8,6" HasShadow="False" BorderColor="#4a3e8c">
                                <Label x:Name="SerialNoLabel" Text="------" FontSize="11" FontAttributes="Bold" TextColor="#FFDD00" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- OTP Action Buttons -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="⚡ Tạo mã OTP" BackgroundColor="#4a3e8c" TextColor="#ffffff" 
                                CornerRadius="8" HeightRequest="40" FontSize="13" FontAttributes="Bold" Clicked="OnGetOtpClicked" />
                        <Button Grid.Column="1" x:Name="OpenActiveWebBtn" Text="🌐 Mở Web Kích hoạt" BackgroundColor="#222044" TextColor="#8e94f7" 
                                CornerRadius="8" HeightRequest="40" FontSize="13" Clicked="OnOpenActiveWebClicked" IsEnabled="False" />
                    </Grid>

                    <!-- Debug OTA Log Box (Displaying Sent JSON Request & Received JSON Response Live) -->
                    <VerticalStackLayout Spacing="4" Margin="0,6,0,0">
                        <Label Text="📜 Nhật ký Gói tin OTA (Request &amp; Response):" FontSize="11" TextColor="#a0a0ff" FontAttributes="Bold" />
                        <Frame BackgroundColor="#090814" CornerRadius="8" Padding="8" HasShadow="False" BorderColor="#2a254d">
                            <Editor x:Name="OtaLogEditor" Text="Bấm 'Tạo mã OTP' để xem chi tiết gói tin gửi đi và phản hồi từ Server..." 
                                    FontSize="11" TextColor="#00FFC8" FontFamily="Courier" IsReadOnly="True" 
                                    HeightRequest="120" AutoSize="Disabled" BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Server WebSocket URL -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Server WebSocket URL:" TextColor="#d0d0ff" FontSize="14" FontAttributes="Bold" />
                <Frame BackgroundColor="#1c1936" CornerRadius="10" Padding="12,0" HasShadow="False" BorderColor="#2a254d">
                    <Entry x:Name="WsUrlEntry" TextColor="#ffffff" PlaceholderColor="#606080" HeightRequest="44" />
                </Frame>
            </VerticalStackLayout>

            <!-- Access Token -->
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Access Token / Auth Token:" TextColor="#d0d0ff" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="📋 Dán" BackgroundColor="#222044" TextColor="#a0a0ff" FontSize="12" Padding="6,2" HeightRequest="30" Clicked="OnPasteTokenClicked" />
                </Grid>
                <Frame BackgroundColor="#1c1936" CornerRadius="10" Padding="12,0" HasShadow="False" BorderColor="#2a254d">
                    <Entry x:Name="TokenEntry" TextColor="#ffffff" PlaceholderColor="#606080" HeightRequest="44" />
                </Frame>
            </VerticalStackLayout>

            <!-- Device MAC Address -->
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Device MAC Address (Device-Id):" TextColor="#d0d0ff" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="🎲 Tạo MAC Mới" BackgroundColor="#222044" TextColor="#00FFC8" FontSize="12" Padding="6,2" HeightRequest="30" Clicked="OnRandomMacClicked" />
                </Grid>
                <Frame BackgroundColor="#1c1936" CornerRadius="10" Padding="12,0" HasShadow="False" BorderColor="#2a254d">
                    <Entry x:Name="DeviceIdEntry" TextColor="#ffffff" PlaceholderColor="#606080" HeightRequest="44" />
                </Frame>
            </VerticalStackLayout>

            <!-- Client ID -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Client ID:" TextColor="#d0d0ff" FontSize="14" FontAttributes="Bold" />
                <Frame BackgroundColor="#1c1936" CornerRadius="10" Padding="12,0" HasShadow="False" BorderColor="#2a254d">
                    <Entry x:Name="ClientIdEntry" TextColor="#ffffff" PlaceholderColor="#606080" HeightRequest="44" />
                </Frame>
            </VerticalStackLayout>

            <!-- OTA Manual App Update Button -->
            <Button Text="🚀 Kiểm tra Cập nhật App Mới (OTA)" BackgroundColor="#1a2e40" TextColor="#00FFC8" 
                    CornerRadius="10" HeightRequest="44" FontSize="13" FontAttributes="Bold" BorderColor="#00FFC8" Margin="0,10,0,5" Clicked="OnCheckAppUpdateClicked" />

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,15,0,25">
                <Button Grid.Column="0" Text="🔄 Mặc định" BackgroundColor="#222238" TextColor="#ff6b81" 
                        CornerRadius="10" HeightRequest="48" FontSize="11" Clicked="OnResetClicked" />
                <Button Grid.Column="1" Text="❌ Đóng" BackgroundColor="#221045" TextColor="#FF5E36" 
                        CornerRadius="10" HeightRequest="48" FontSize="12" FontAttributes="Bold" BorderColor="#FF5E36" Clicked="OnCloseClicked" />
                <Button Grid.Column="2" Text="💾 Lưu &amp; Kết nối" BackgroundColor="#bd00ff" TextColor="#ffffff" 
                        FontAttributes="Bold" CornerRadius="10" HeightRequest="48" FontSize="11" Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
