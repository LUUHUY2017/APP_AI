<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Xiaozhi.App.Maui"
             x:Class="Xiaozhi.App.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryBackground">#0d0b1a</Color>
            <Color x:Key="SecondaryBackground">#18152e</Color>
            <Color x:Key="AccentColor">#8a2be2</Color>
            <Color x:Key="TextColor">#ffffff</Color>
            <Color x:Key="MutedText">#a0a0c0</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
