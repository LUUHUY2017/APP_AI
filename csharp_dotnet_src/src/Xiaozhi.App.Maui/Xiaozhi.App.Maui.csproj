<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-ios</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Xiaozhi.App.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>

		<!-- Display name -->
		<ApplicationTitle>Lily AI Assistant</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.xiaozhi.ai.lily</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Xiaozhi.Core\Xiaozhi.Core.csproj" />
		<ProjectReference Include="..\Xiaozhi.Audio\Xiaozhi.Audio.csproj" />
		<ProjectReference Include="..\Xiaozhi.Protocols\Xiaozhi.Protocols.csproj" />
		<ProjectReference Include="..\Xiaozhi.Mcp\Xiaozhi.Mcp.csproj" />
	</ItemGroup>

</Project>
