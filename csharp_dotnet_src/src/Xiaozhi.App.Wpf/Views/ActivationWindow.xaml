<Window x:Class="Xiaozhi.App.Wpf.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích hoạt thiết bị Xiaozhi" 
        Height="520" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#181824"
        Foreground="#E0E0E6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="📱 Kích hoạt thiết bị / Lấy Token" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Main QR Code Area -->
        <Border Grid.Row="1" Background="#222232" CornerRadius="16" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Image x:Name="ImgQrCode" Width="180" Height="180" Margin="0,0,0,12"/>
                
                <TextBlock Text="Mã xác nhận (Code):" FontSize="12" Foreground="#A0A0B5" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtActivationCode" Text="------" FontSize="26" FontWeight="Bold" Foreground="#7C4DFF" HorizontalAlignment="Center" Margin="0,2,0,5"/>
                
                <TextBlock x:Name="TxtStatus" Text="Đang tạo mã kích hoạt..." FontSize="13" Foreground="#B0B0C5" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Instructions -->
        <TextBlock Grid.Row="2" Text="Quét mã QR bằng điện thoại hoặc truy cập xiaozhi.tenclass.net để liên kết tài khoản. Token sẽ được tự động điền khi xác nhận xong." 
                   TextWrapping="Wrap" FontSize="12" Foreground="#8E8EA8" TextAlignment="Center" Margin="10,15,10,15"/>

        <!-- Action Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Đóng" Width="100" Padding="10,6" Background="#383848" Foreground="White" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
