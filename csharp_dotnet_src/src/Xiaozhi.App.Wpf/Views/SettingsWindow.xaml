<Window x:Class="Xiaozhi.App.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt hệ thống (Settings)" 
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        Foreground="#E0E0E6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙ Cấu hình Lily Client" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="WebSocket Server URL:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtServerUrl" Padding="8,5" Background="#282838" Foreground="White" BorderBrush="#404060" Margin="0,0,0,10"/>

            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="Token xác thực:" VerticalAlignment="Center"/>
                <Button Content="📲 Quét QR lấy Token" DockPanel.Dock="Right" HorizontalAlignment="Right" 
                        Padding="8,3" Background="#7C4DFF" Foreground="White" FontSize="11" FontWeight="SemiBold" Click="GetTokenQr_Click"/>
            </DockPanel>
            <TextBox x:Name="TxtToken" Padding="8,5" Background="#282838" Foreground="White" BorderBrush="#404060" Margin="0,0,0,10"/>

            <TextBlock Text="Từ khóa đánh thức (Wake Word):" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtWakeWord" Text="xiaozhi" Padding="8,5" Background="#282838" Foreground="White" BorderBrush="#404060" Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkWakeWord" Content="Bật nhận diện giọng nói (Voice Activation)" IsChecked="True" Foreground="#D0D0E0" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Padding="10,6" Margin="0,0,10,0" Background="#383848" Foreground="White" Click="Cancel_Click"/>
            <Button Content="Lưu" Width="80" Padding="10,6" Background="#7C4DFF" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
