<Window x:Class="Xiaozhi.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Xiaozhi.App.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Lily - AI Assistant (.NET 10)"
        Height="720" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D17"
        Foreground="#E0E0F0">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IOS DYNAMIC ISLAND & STATUS BAR -->
        <Border Grid.Row="0" x:Name="IPhoneHeaderBar" Background="#161626" Padding="16,6" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="IPhoneClock" Text="22:57" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                
                <!-- DYNAMIC ISLAND PILL -->
                <Border Width="100" Height="24" Background="Black" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#1E1E30" Margin="0,0,6,0"/>
                        <Ellipse Width="6" Height="6" Fill="#0D0D17"/>
                    </StackPanel>
                </Border>

                <!-- STATUS ICONS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="5G" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="📶" Foreground="White" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="🔋 100%" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HEADER -->
        <Border Grid.Row="1" Background="#161626" Padding="14,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Hands-free mode button -->
                    <Button x:Name="HandsFreeBtn" ToolTip="Bật/Tắt chế độ Rảnh tay liên tục (Iron Man)"
                            Background="#222238" BorderBrush="#7C4DFF" BorderThickness="1"
                            Foreground="#B0B0E0" FontSize="11" Padding="8,4" Click="HandsFree_Click"
                            Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="HandsFreeLabel" Text="🎙️ Rảnh tay: Tắt" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- Refresh sync button -->
                    <Button ToolTip="Làm mới &amp; Đồng bộ cấu hình từ web"
                            Width="34" Height="34" Background="Transparent" BorderBrush="Transparent"
                            Foreground="#8888BB" FontSize="16" Click="RefreshSync_Click" Cursor="Hand" Margin="0,0,4,0">
                        <TextBlock Text="🔄" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Simulate iPhone 14/15 Pro button -->
                    <Button ToolTip="Giả lập kích thước iPhone 14/15 Pro (390x844)"
                            Width="34" Height="34" Background="Transparent" BorderBrush="Transparent"
                            Foreground="#8888BB" FontSize="16" Click="SimulateIPhone_Click" Cursor="Hand" Margin="0,0,4,0">
                        <TextBlock Text="📱" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Settings button -->
                    <Button ToolTip="Cài đặt"
                            Width="34" Height="34" Background="Transparent" BorderBrush="Transparent"
                            Foreground="#8888BB" FontSize="18" Click="OpenSettings_Click" Cursor="Hand">
                        <TextBlock Text="⚙" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusLabel" Text="✅ Sẵn sàng" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#C0C0D8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CHAT LOG -->
        <ScrollViewer Grid.Row="2" x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto" Background="#0D0D17" Padding="12,8">
            <StackPanel x:Name="ChatStack" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- CURRENT STATUS BUBBLE -->
        <Border Grid.Row="3" Background="#161628" Padding="14,8" MinHeight="36">
            <TextBlock x:Name="CurrentMsgLabel" Text="Bấm nút 🎤 để nói (hoặc nói xong tự ngắt)." 
                       TextWrapping="Wrap" FontSize="12" Foreground="#A0A0D0" LineHeight="18"/>
        </Border>

        <!-- TEXT INPUT ROW -->
        <Border Grid.Row="4" Background="#121222" Padding="10,6">
            <DockPanel>
                <Button Content="Gửi" DockPanel.Dock="Right" Width="60" Height="34"
                        Background="#6B3FCC" Foreground="White" FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand" Click="SendText_Click" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox x:Name="TxtInput" 
                         PreviewKeyDown="TxtInput_PreviewKeyDown"
                         KeyDown="TxtInput_KeyDown"
                         AcceptsReturn="False"
                         Background="#1E1E34" Foreground="White" BorderThickness="0"
                         FontSize="13" Padding="12,7" VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- BOTTOM: AVATAR + HOLD BUTTON + ABORT -->
        <Grid Grid.Row="5" Background="#0F0F1E">
            <!-- Avatar pulse ring -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse x:Name="PulseRing" Width="60" Height="60"
                         Stroke="#FF4466" StrokeThickness="2" Opacity="0"/>
                <Border x:Name="AvatarBorder" Width="50" Height="50" Background="#202040"
                        CornerRadius="25" BorderBrush="#7C4DFF" BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarEmoji" Text="🌸" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Hold-to-talk button area -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50,0,0,0">
                <TextBlock x:Name="TalkHintLabel" Text="👇 Bấm để nói (nói xong tự gửi)"
                           FontSize="10" Foreground="#666699"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <Border x:Name="TalkBtnBorder" CornerRadius="24" Background="#6B3FCC"
                        Width="210" Height="48" Cursor="Hand"
                        MouseLeftButtonDown="TalkBtn_MouseDown"
                        MouseLeftButtonUp="TalkBtn_MouseUp"
                        MouseLeave="TalkBtn_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TalkBtnIcon" Text="🎤" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TalkBtnLabel" Text="Bấm để nói" FontSize="14"
                                   FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Abort button -->
            <Border x:Name="AbortBtnBorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,12,0" CornerRadius="10" Background="#3A2060"
                    Cursor="Hand" Visibility="Collapsed"
                    MouseLeftButtonDown="AbortBtn_Click" Padding="8,6">
                <TextBlock Text="⏹ Dừng" Foreground="#CC88FF" FontSize="11"/>
            </Border>
        </Grid>

        <!-- IOS HOME INDICATOR BAR -->
        <Border Grid.Row="6" x:Name="IPhoneHomeBar" Background="#0F0F1E" Padding="0,4,0,8" Visibility="Collapsed">
            <Border Width="134" Height="5" Background="#8888AA" CornerRadius="2.5" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
