<Window x:Class="Xiaozhi.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Xiaozhi.App.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Lily - AI Assistant (.NET 10)"
        Height="720" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D17"
        Foreground="#E0E0F0">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#161626" Padding="14,0">
            <DockPanel>
                <Button Content="⚙" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Width="34" Height="34" Background="Transparent" BorderBrush="Transparent"
                        Foreground="#8888BB" FontSize="18" Click="OpenSettings_Click" Cursor="Hand"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF4444" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusLabel" Text="Đang kết nối..." FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#C0C0D8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CHAT LOG -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto" Background="#0D0D17" Padding="12,8">
            <StackPanel x:Name="ChatStack" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- CURRENT STATUS BUBBLE -->
        <Border Grid.Row="2" Background="#161628" Padding="14,8" MinHeight="40">
            <TextBlock x:Name="CurrentMsgLabel" Text="👇 Nhấn GIỮ 🎤 để nói, hoặc gõ tin nhắn bên dưới." 
                       TextWrapping="Wrap" FontSize="12" Foreground="#A0A0D0" LineHeight="18"/>
        </Border>

        <!-- TEXT INPUT ROW -->
        <Border Grid.Row="3" Background="#121222" Padding="10,6">
            <DockPanel>
                <Button Content="Gửi" DockPanel.Dock="Right" Width="55" Height="32"
                        Background="#6B3FCC" Foreground="White" FontWeight="Bold" FontSize="12"
                        BorderThickness="0" Cursor="Hand" Click="SendText_Click" Margin="6,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox x:Name="TxtInput" KeyDown="TxtInput_KeyDown"
                         Background="#1E1E34" Foreground="White" BorderThickness="0"
                         FontSize="13" Padding="10,6" VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="16"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- BOTTOM: AVATAR + HOLD BUTTON + ABORT -->
        <Grid Grid.Row="4" Background="#0F0F1E">
            <!-- Avatar pulse ring -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse x:Name="PulseRing" Width="60" Height="60"
                         Stroke="#FF4466" StrokeThickness="2" Opacity="0"/>
                <Border x:Name="AvatarBorder" Width="50" Height="50" Background="#202040"
                        CornerRadius="25" BorderBrush="#7C4DFF" BorderThickness="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarEmoji" Text="🌸" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Hold-to-talk button area -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50,0,0,0">
                <TextBlock x:Name="TalkHintLabel" Text="👇 Nhấn GIỮ để nói, THẢ để gửi"
                           FontSize="10" Foreground="#666699"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <Border x:Name="TalkBtnBorder" CornerRadius="24" Background="#6B3FCC"
                        Width="210" Height="48" Cursor="Hand"
                        MouseLeftButtonDown="TalkBtn_MouseDown"
                        MouseLeftButtonUp="TalkBtn_MouseUp"
                        MouseLeave="TalkBtn_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TalkBtnIcon" Text="🎤" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TalkBtnLabel" Text="Giữ để nói" FontSize="14"
                                   FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Abort button -->
            <Border x:Name="AbortBtnBorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,12,0" CornerRadius="10" Background="#3A2060"
                    Cursor="Hand" Visibility="Collapsed"
                    MouseLeftButtonDown="AbortBtn_Click" Padding="8,6">
                <TextBlock Text="⏹ Dừng" Foreground="#CC88FF" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
